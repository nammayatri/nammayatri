  "defaults": {
    "maxRows": 5000,
    "ignore": [
      "created_at",
      "updated_at"
    ],
    "keepPatterns": [
      "_encrypted$",
      "_hash$",
      "_private_key$",
      "_secret$",
      "_token$",
      "_password$"
    ],
    "rewrite": {
      "merchant_id": "merchant_id",
      "merchant_short_id": "merchant_short_id",
      "city": "city"
    }
  },
  "scope": {
    "name": "city",
    "optionsSql": "select id::text as id, city::text as city, merchant_id::text as merchant_id, merchant_short_id::text as merchant_short_id from {schema}.merchant_operating_city order by merchant_short_id, city limit 5000",
    "valueField": "id",
    "labelField": "city",
    "displayFields": [
      "merchant_short_id",
      "city",
      "id"
    ],
    "filters": {
      "merchant_operating_city_id": "id",
      "merchant_id": "merchant_id",
      "merchant_opt_city_id": "id"
    }
  },
