// Builds Backend/dev/Dockerfile (test dashboard + context-api + config-sync)
// and pushes it to the ny-sandbox GCP Artifact Registry. Mirrors
// control-center's Jenkinsfile push pattern (same GCP_AR shape, same
// gcp-sa-key credential).
//
// Configure this job's "Script Path" to Backend/dev/Jenkinsfile rather than
// adding a root Jenkinsfile to the monorepo — keeps this pipeline scoped to
// the test-dashboard build only.
//
// Note: this image does NOT include test-tool/local-api (port 7083) —
// /api/qa-collections/{run,sync,webhook,...} won't work in a pod built from
// just this image, only the Collections tab's listing (via context-api).
pipeline {
  agent {
    kubernetes {
      label 'dind-agent'
    }
  }

  environment {
    GCP_PROJECT = 'ny-sandbox'
    GCP_AR = "asia-south1-docker.pkg.dev/${GCP_PROJECT}"
    IMAGE_NAME = 'ny-automation'
  }

  stages {
    stage('Initialize') {
      steps {
        script {
          env.LAST_COMMIT_HASH = sh(script: "git rev-parse HEAD", returnStdout: true).trim().substring(0, 6)
        }
      }
    }

    stage('Build') {
      steps {
        sh "cd Backend/dev && docker build --no-cache -t ${env.IMAGE_NAME}:staging-gcp ."
      }
    }

    stage('Push to GCP Sandbox') {
      steps {
        withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GCP_KEY_FILE')]) {
          script {
            // Login
            sh 'cat $GCP_KEY_FILE | docker login -u _json_key --password-stdin https://asia-south1-docker.pkg.dev'

            // Tag and push (commit-hash tag)
            sh "docker tag ${env.IMAGE_NAME}:staging-gcp ${env.GCP_AR}/${env.IMAGE_NAME}/${env.IMAGE_NAME}:${env.LAST_COMMIT_HASH}"
            sh "docker push ${env.GCP_AR}/${env.IMAGE_NAME}/${env.IMAGE_NAME}:${env.LAST_COMMIT_HASH}"

            // Latest tag
            sh "docker tag ${env.IMAGE_NAME}:staging-gcp ${env.GCP_AR}/${env.IMAGE_NAME}/${env.IMAGE_NAME}:latest"
            sh "docker push ${env.GCP_AR}/${env.IMAGE_NAME}/${env.IMAGE_NAME}:latest"
          }
        }
      }
    }
  }
}
