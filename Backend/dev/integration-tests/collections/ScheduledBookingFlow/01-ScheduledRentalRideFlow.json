    {
      "name": "Ride Search (Rental, 4hr/40km)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var startTs = new Date(Date.now() + 45 * 60 * 1000).toISOString(); pm.environment.set('_rental_start_time', startTs);"
