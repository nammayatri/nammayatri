          "mode": "raw",
          "raw": "{\"fareProductType\": \"RENTAL\", \"contents\": {\"origin\": {\"address\": {\"area\": \"Test Rental Origin\", \"areaCode\": \"560001\", \"city\": \"{{city}}\", \"country\": \"India\", \"state\": \"{{state}}\"}, \"gps\": {\"lat\": {{origin_lat}}, \"lon\": {{origin_lon}}}}, \"isSourceManuallyMoved\": false, \"startTime\": \"{{_rental_start_time}}\", \"estimatedRentalDistance\": {{rental_distance_meters}}, \"estimatedRentalDuration\": {{rental_duration_seconds}}}}"
        },
        "url": {
