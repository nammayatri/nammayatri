    {
      "name": "Get Rental Quotes",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const s=Date.now(); while(Date.now()-s<3000){}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var d = pm.response.json();",
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var quotes = d.quotes || [];",
              "var want = pm.environment.get('vehicle_variant') || 'SEDAN';",
              "var pick = null;",
              "for (var i=0; i<quotes.length; i++) {",
              "  var inner = quotes[i].onRentalCab || quotes[i].onDemandCab;",
              "  if (!inner) continue;",
              "  if (inner.vehicleVariant === want) { pick = inner; break; }",
              "}",
              "if (!pick && quotes.length > 0) pick = quotes[0].onRentalCab || quotes[0].onDemandCab;",
              "if (pick) { pm.environment.set('quoteId', pick.id); console.log('Rental Quote:', pick.id, 'variant:', pick.vehicleVariant, 'fare:', pick.estimatedTotalFare); console.log('All quotes:', quotes.map(function(q){var i=q.onRentalCab||q.onDemandCab; return i?i.vehicleVariant+'='+i.estimatedTotalFare:'?';}).join(', ')); }",
              "pm.test('Has rental quotes', function () { pm.expect(pm.environment.get('quoteId')).to.be.a('string').that.is.not.empty; });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "token",
            "value": "{{rider_token}}"
          }
        ],
