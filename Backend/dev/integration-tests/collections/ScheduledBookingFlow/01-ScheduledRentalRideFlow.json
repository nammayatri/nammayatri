          "listen": "test",
          "script": {
            "exec": [
              "var d = pm.response.json(); pm.environment.set('searchId', d.searchId); console.log('Rental Search ID:', d.searchId); pm.test('Status 200', function () { pm.response.to.have.status(200); }); const s=Date.now(); const w=parseInt(pm.environment.get('search_wait_ms')||'8000',10); while(Date.now()-s<w){}"
            ],
            "type": "text/javascript"
          }
        }
