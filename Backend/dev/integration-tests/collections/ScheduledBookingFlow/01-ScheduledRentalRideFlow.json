    {
      "name": "Verify in Scheduled Bookings (Dashboard)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var d = pm.response.json();",
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var bookings = (d && d.bookings) || [];",
              "var bid = pm.environment.get('customer_bookingId');",
              "console.log('scheduledBooking/list totalItems=', d.totalItems, 'looking for bookingId=', bid);",
              "var found = bookings.filter(function (b) { return b.bookingId === bid; });",
              "pm.test('Scheduled booking present in dashboard list', function () { pm.expect(found.length, 'booking in list').to.be.above(0); });",
              "if (found.length) { pm.test('Booking is a scheduled Rental (NEW/unassigned)', function () { pm.expect(found[0].bookingStatus).to.equal('NEW'); pm.expect(JSON.stringify(found[0].tripCategory)).to.include('Rental'); }); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "token",
            "value": "{{dashboard_token}}"
          }
        ],
        "url": {
          "raw": "{{baseURL_BPP_Dashboard_Internal}}/{{dashboard_merchant_id}}/{{dashboard_city}}/scheduledBooking/list?assignmentStatus=\"UNASSIGNED\"&limit=50&offset=0",
          "host": [
            "{{baseURL_BPP_Dashboard_Internal}}"
