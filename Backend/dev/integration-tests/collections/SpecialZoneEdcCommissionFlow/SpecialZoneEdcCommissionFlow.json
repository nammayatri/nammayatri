  {
   "name": "Read Payment Order (capture orderId + shortId)",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "var d = pm.response.json();",
       "pm.test('payment order exists', function () { pm.expect(d.count).to.be.above(0); });",
       "if (d.rows && d.rows[0]) {",
       "  pm.environment.set('orderId', d.rows[0].id);",
