   "name": "Restore Pre-test DP Rollout (BPP)",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     },
     {
      "key": "token",
      "value": "{{dashboard_token}}"
     }
    ],
    "url": {
     "raw": "{{baseURL_BPP_Dashboard_Internal}}/{{dashboard_merchant_id}}/{{dashboard_city}}/nammaTag/appDynamicLogic/upsertLogicRollout",
     "host": [
      "{{baseURL_BPP_Dashboard_Internal}}"
     ],
     "path": [
      "{{dashboard_merchant_id}}",
      "{{dashboard_city}}",
      "nammaTag",
      "appDynamicLogic",
      "upsertLogicRollout"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{{_test_dp_restore_body}}"
    }
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "exec": [
       "var prev = JSON.parse(pm.collectionVariables.get('_test_dp_prev_rollout') || '[]');",
       "if (!Array.isArray(prev) || prev.length === 0) { prev = [{domain: {tag: 'DYNAMIC_PRICING_UNIFIED'}, timeBounds: 'Unbounded', rollout: []}]; }",
       "pm.collectionVariables.set('_test_dp_restore_body', JSON.stringify(prev));"
      ],
      "type": "text/javascript"
     }
    },
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('Rollout restored', function () { pm.response.to.have.status(200); });",
       "console.log('Restored DYNAMIC-PRICING-UNIFIED rollout to:', pm.collectionVariables.get('_test_dp_restore_body'));"
      ],
      "type": "text/javascript"
     }
    }
   ]
  }
