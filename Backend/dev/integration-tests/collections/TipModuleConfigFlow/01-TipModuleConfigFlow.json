  {
   "name": "Verify QAR Bands (actualQAR 0.2 -> low)",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     },
     {
      "key": "token",
      "value": "{{dashboard_token}}"
     }
    ],
    "url": {
     "raw": "{{baseURL_BPP_Dashboard_Internal}}/{{dashboard_merchant_id}}/{{dashboard_city}}/nammaTag/appDynamicLogic/verify",
     "host": [
      "{{baseURL_BPP_Dashboard_Internal}}"
     ],
     "path": [
      "{{dashboard_merchant_id}}",
      "{{dashboard_city}}",
      "nammaTag",
      "appDynamicLogic",
      "verify"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\"domain\": {\"tag\": \"DYNAMIC_PRICING_UNIFIED\"}, \"rules\": [{\"cat\": [{\"var\": \"\"}, {\"qarPct\": {\"if\": [{\"==\": [{\"var\": \"actualQAR\"}, null]}, null, {\"*\": [100, {\"var\": \"actualQAR\"}]}]}}]}, {\"cat\": [{\"var\": \"\"}, {\"tipModuleConfig\": {\"cat\": [{\"showAfterSec\": {\"if\": [{\"==\": [{\"var\": \"qarPct\"}, null]}, 45, {\"if\": [{\"<\": [{\"var\": \"qarPct\"}, 30]}, 15, {\"if\": [{\"<\": [{\"var\": \"qarPct\"}, 60]}, 30, 60]}]}]}}, {\"repeatIntervalSec\": {\"if\": [{\"==\": [{\"var\": \"qarPct\"}, null]}, 60, {\"if\": [{\"<\": [{\"var\": \"qarPct\"}, 30]}, 30, {\"if\": [{\"<\": [{\"var\": \"qarPct\"}, 60]}, 45, 0]}]}]}}, {\"maxPrompts\": {\"if\": [{\"==\": [{\"var\": \"qarPct\"}, null]}, 1, {\"if\": [{\"<\": [{\"var\": \"qarPct\"}, 30]}, 3, {\"if\": [{\"<\": [{\"var\": \"qarPct\"}, 60]}, 2, 1]}]}]}}]}}]}], \"inputData\": [{\"actualQAR\": 0.2, \"serviceTier\": \"AUTO_RICKSHAW\", \"distanceInKm\": 3.0, \"speedKmh\": 20.0}], \"shouldUpdateRule\": false, \"verifyOutput\": true}"
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "var d = pm.response.json();",
       "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
       "pm.test('No rule errors', function () { pm.expect(d.errors, 'errors').to.be.an('array').that.is.empty; });",
       "pm.test('actualQAR=0.2 -> tipModuleConfig {15,30,3}', function () {",
       "    pm.expect(d.result.tipModuleConfig, 'tipModuleConfig').to.be.an('object');",
       "    pm.expect(d.result.tipModuleConfig.showAfterSec).to.eql(15);",
       "    pm.expect(d.result.tipModuleConfig.repeatIntervalSec).to.eql(30);",
       "    pm.expect(d.result.tipModuleConfig.maxPrompts).to.eql(3);",
       "});",
       "pm.test('Rule not persisted (verify only)', function () { pm.expect(d.isRuleUpdated).to.eql(false); });"
      ],
      "type": "text/javascript"
     }
    }
   ]
  },
