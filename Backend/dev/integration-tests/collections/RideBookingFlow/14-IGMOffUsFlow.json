              "pm.test(\"Status 200\",function(){pm.response.to.have.status(200);});",
              "var d=pm.response.json();",
              "var igmId=pm.collectionVariables.get(\"_igm_issue_id\");",
              "if(d.issues){",
              "  for(var i=0;i<d.issues.length;i++){",
              "    if(d.issues[i].becknIssueId===igmId){",
              "      pm.collectionVariables.set(\"igm_issue_report_id\",d.issues[i].issueReportId);",
              "      console.log(\"Found issue_report_id:\",d.issues[i].issueReportId,\"for IGM:\",igmId);",
              "      break;",
              "    }",
              "  }",
              "}",
              "pm.test(\"Found IGM issue report\",function(){",
              "  pm.expect(pm.collectionVariables.get(\"igm_issue_report_id\")).to.not.be.empty;",
              "});"
            ],
