              "var d=pm.response.json();",
              "pm.test('OPEN',function(){pm.expect(d.igmStatus).to.eql('OPEN');});",
              "pm.test('Complainant OPEN',function(){pm.expect(d.complainantActions[0].action).to.eql('OPEN');});",
              "pm.test('Respondent PROCESSING',function(){pm.expect(d.respondentActions[0].action).to.eql('PROCESSING');});",
              "pm.test('No resolution',function(){pm.expect(d.resolution).to.be.null;});",
              "pm.test('FULFILLMENT',function(){pm.expect(d.category).to.eql('FULFILLMENT');});",
              "pm.test('FLM111',function(){pm.expect(d.subCategory).to.eql('FLM111');});",
              "pm.test('CONSUMER',function(){pm.expect(d.source).to.eql('CONSUMER');});",
              "pm.test('PT2H',function(){pm.expect(d.expectedResponseTime).to.eql('PT2H');});",
              "pm.test('P1D',function(){pm.expect(d.expectedResolutionTime).to.eql('P1D');});",
              "pm.test('GRO',function(){pm.expect(d.resolutionProvider.groName).to.not.be.null;});",
              "console.log('Trail OPEN OK');"
            ],
            "type": "text/javascript"
          }
        }
