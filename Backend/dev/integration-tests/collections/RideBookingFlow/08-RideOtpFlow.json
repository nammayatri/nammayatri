    {
      "name": "Get Search Results (Expect Quotes)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "setTimeout(function(){}, 3000);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var d = pm.response.json();",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "",
              "// RideOTP flow returns quotes (not estimates).",
              "// Pick the tier this city's SEDAN driver can serve (env: ride_otp_service_tier, e.g. COMFY in Bangalore).",
              "// No silent fallback: booking another tier (e.g. SUV) makes otpRide/start fail with \"Wrong Vehicle Variant\".",
              "var quotes = d.quotes || [];",
              "var wantTier = pm.environment.get('ride_otp_service_tier');",
              "var available = quotes.map(function (q) { var i = q.onDemandCab || q.onRentalCab || q.onMeterRide; return i ? i.vehicleVariant + '=' + i.estimatedTotalFare : '?'; });",
              "var szQuote = null;",
              "for (var i = 0; i < quotes.length; i++) {",
              "    var inner = quotes[i].onDemandCab || quotes[i].onRentalCab || quotes[i].onMeterRide;",
              "    if (inner && inner.vehicleVariant === wantTier) {",
              "        szQuote = inner;",
              "        break;",
              "    }",
              "}",
              "pm.environment.set('sz_quoteId', '');  // clear any stale id (runner has no environment.unset)",
              "if (szQuote) {",
              "    pm.environment.set('sz_quoteId', szQuote.id);",
              "    console.log('Selected Quote:', szQuote.id, 'tier:', szQuote.vehicleVariant, 'fare:', szQuote.estimatedTotalFare);",
              "}",
              "console.log('Available quotes:', available.join(', '), '| wanted:', wantTier);",
              "pm.test('ride_otp_service_tier is set in env', function () {",
              "    pm.expect(wantTier, 'set ride_otp_service_tier in the env file').to.be.a('string').that.is.not.empty;",
              "});",
              "pm.test('Quote offered for ' + wantTier, function () {",
              "    pm.expect(szQuote, 'no ' + wantTier + ' quote offered; available: ' + available.join(', ')).to.not.be.null;",
              "});",
              "var noAdjustment = function (x) { return !x || Number(x) === 0; };",
              "(d.quotes || []).forEach(function (q) {",
              "    var inner = q.onDemandCab || q.onRentalCab || q.onMeterRide;",
              "    if (!inner) return;",
              "    pm.test('Quote ' + inner.vehicleVariant + ': total fare equals fare (no tax, charge or discount)', function () { pm.expect(Number(inner.estimatedTotalFare)).to.eql(Number(inner.estimatedFare)); });",
              "    pm.test('Quote ' + inner.vehicleVariant + ': no discount', function () { pm.expect(noAdjustment(inner.discount)).to.eql(true); });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "token",
            "value": "{{rider_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl_app}}/rideSearch/{{searchId}}/results",
