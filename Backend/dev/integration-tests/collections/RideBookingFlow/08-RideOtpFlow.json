    {
      "name": "Get Booking (Extract Special Zone OTP)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const start = Date.now();",
              "while (Date.now() - start < 3000) { /* busy wait */ }"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var d = pm.response.json();",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "",
              "if (d.list && d.list.length > 0) {",
              "    var booking = d.list[0];",
              "    pm.environment.set('customer_bookingId', booking.id);",
              "    // In RideOTP flow, OTP is at bookingDetails.contents.otpCode",
              "    var szOtp = null;",
              "    if (booking.bookingDetails && booking.bookingDetails.contents && booking.bookingDetails.contents.otpCode) {",
              "        szOtp = booking.bookingDetails.contents.otpCode;",
              "    }",
              "    pm.environment.set('sz_otp', szOtp || '');",
              "    console.log('Booking:', booking.id, 'Status:', booking.status, 'OTP:', szOtp, 'tripCategory:', JSON.stringify(booking.tripCategory));",
              "    pm.test('Booking status is NEW or CONFIRMED', function () {",
              "        pm.expect(booking.status).to.be.oneOf(['NEW', 'CONFIRMED']);",
              "    });",
              "}",
              "pm.test('Has special zone OTP', function () {",
              "    pm.expect(pm.environment.get('sz_otp')).to.be.a('string').that.is.not.empty;",
              "});",
              "if (d.list && d.list.length > 0) {",
              "    var bookingFare = d.list[0];",
              "    pm.test('Booking total fare equals fare (no tax, charge or discount)', function () { pm.expect(Number(bookingFare.estimatedTotalFare)).to.eql(Number(bookingFare.estimatedFare)); });",
              "    pm.test('Booking has no discount', function () { pm.expect(!bookingFare.discount || Number(bookingFare.discount) === 0).to.eql(true); });",
              "    pm.environment.set('_bap_booking_fare', bookingFare.estimatedTotalFare);",
              "}",
              "// fare breakup checks",
              "if (d.list && d.list.length > 0) {",
              "    var fbB = d.list[0];",
              "    var fbLines = fbB.estimatedFareBreakup || [];",
              "    var fbAmt = function (l) { return Number(l.amountWithCurrency ? l.amountWithCurrency.amount : l.amount); };",
              "    var fbIsSplit = function (t) { return /_(CGST|SGST|IGST)$/.test(t); };",
              "    var fbSum = fbLines.filter(function (l) { return !fbIsSplit(l.description); }).reduce(function (a, l) { return a + fbAmt(l); }, 0);",
              "    var fbPayable = Number(fbB.estimatedTotalFareWithCurrency ? fbB.estimatedTotalFareWithCurrency.amount : fbB.estimatedTotalFare);",
              "    console.log('Booking breakup:', fbLines.map(function (l) { return l.description + '=' + fbAmt(l); }).join(', '), '| payable', fbPayable);",
              "    pm.test('Booking breakup lines (excluding CGST/SGST/IGST splits) sum to the payable fare', function () { pm.expect(Math.round(fbSum)).to.eql(Math.round(fbPayable)); });",
              "    var fbAt = function (t) { return fbLines.filter(function (l) { return l.description === t; }).reduce(function (a, l) { return a + fbAmt(l); }, 0); };",
              "    fbLines.filter(function (l) { return /_TAX$/.test(l.description); }).forEach(function (l) {",
              "        var prefix = l.description.replace(/_TAX$/, '');",
              "        var splits = fbAt(prefix + '_CGST') + fbAt(prefix + '_SGST') + fbAt(prefix + '_IGST');",
              "        if (splits > 0) pm.test(l.description + ' equals its CGST + SGST + IGST split', function () { pm.expect(splits).to.be.closeTo(fbAmt(l), 1); });",
              "    });",
              "    pm.test('No ride fare tax or payment charge line in a cash booking', function () { pm.expect(['RIDE_FARE_TAX', 'PAYMENT_CHARGE', 'PAYMENT_CHARGE_TAX'].every(function (t) { return fbAt(t) === 0; })).to.eql(true); });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "token",
            "value": "{{rider_token}}"
          }
        ],
        "url": {
