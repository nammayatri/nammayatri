{
  "info": {
    "name": "FleetScopeLifecycle - create a fleet and manage who works on it",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// One-time per run: random phones, so the run is repeatable and can run beside others.",
          "if (!pm.collectionVariables.get('_fs_init')) {",
          "  const rnd = () => '9' + String(Math.floor(Math.random() * 900000000) + 100000000).slice(0, 8);",
          "  pm.environment.set('fleet_a_mobile', rnd());",
          "  pm.environment.set('fleet_contact_mobile', rnd());",
          "  pm.environment.set('run_stamp', String(Date.now()));",
          "  pm.collectionVariables.set('_fs_init', '1');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 A - Fleet owner login OTP (direct tree)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseURL_direct}}/{{dashboard_merchant_id}}/{{dashboard_city}}/fleet/v2/login/otp",
        "body": {
          "mode": "raw",
          "raw": "{\"mobileNumber\": \"{{fleet_a_mobile}}\", \"mobileCountryCode\": \"{{country_code}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login otp 200', () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('run_started_at', new Date(Date.now() - 120000).toISOString());",
              "const rnd = () => '9' + String(Math.floor(Math.random() * 1e9)).padStart(9, '0');",
              "pm.environment.set('fleet_a_mobile', rnd());",
              "pm.environment.set('fleet_b_mobile', rnd());"
            ]
          }
        }
      ]
    },
    {
      "name": "01 A - Fleet owner verify OTP (direct tree)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseURL_direct}}/{{dashboard_merchant_id}}/{{dashboard_city}}/fleet/v2/verify/otp",
        "body": {
          "mode": "raw",
          "raw": "{\"mobileNumber\": \"{{fleet_a_mobile}}\", \"mobileCountryCode\": \"{{country_code}}\", \"otp\": \"{{login_otp}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('verify otp 200', () => pm.response.to.have.status(200));",
              "const t = pm.response.json().authToken;",
              "pm.test('session token issued', () => pm.expect(t).to.be.a('string').and.not.empty);",
              "pm.environment.set('fleet_a_token', t);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Resolve A's fleet id (the person the session belongs to)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mockServerUrl}}/mock/sql/select",
        "body": {
          "mode": "raw",
          "raw": "{\"db_name\": \"atlas_dev\", \"db_schema\": \"atlas_dashboard\", \"table_name\": \"registration_token\", \"select\": [\"token\", \"person_id\"], \"where_clause\": [{\"column_name\": \"token\", \"val\": \"{{fleet_a_token}}\", \"op\": \"=\"}], \"limit\": 5}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The app writes through Redis and a drainer copies to Postgres, so a row can take a while to appear: ask again.",
              "const retryKey = '_retry_' + pm.info.requestId;",
              "const attempts = Number(pm.environment.get(retryKey) || 0);",
              "if (((pm.response.json().rows) || []).length === 0 && attempts < 6) {",
              "  pm.environment.set(retryKey, attempts + 1);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "const rows = (pm.response.json().rows) || [];",
              "pm.test('found the session', () => pm.expect(rows.length).to.equal(1));",
              "pm.environment.set('fleet_a_id', rows[0].person_id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 15000); // the app writes through a key-value store and the drainer copies to Postgres; the DB read below must wait for it"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Make sure the create-fleet endpoint is mapped to a capability (idempotent)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mockServerUrl}}/mock/sql/insert",
        "body": {
          "mode": "raw",
          "raw": "{\"db_name\": \"atlas_dev\", \"db_schema\": \"atlas_dashboard\", \"table_name\": \"capability_endpoint\", \"values\": {\"capability_id\": \"fleet.onboarding.write\", \"server_name\": \"DASHBOARD\", \"endpoint_id\": \"PROVIDER_FLEET/REGISTRATION_V2/POST_REGISTRATION_V2_CREATE_FLEET\"}, \"on_conflict_do_nothing\": true}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('mapped', () => pm.expect(pm.response.code).to.equal(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - A creates a fleet",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "token",
            "value": "{{fleet_a_token}}"
          }
        ],
        "url": "{{baseURL_direct}}/{{dashboard_merchant_id}}/{{dashboard_city}}/fleet/v2/create",
        "body": {
          "mode": "raw",
          "raw": "{\"fleetName\": \"Scope test fleet {{run_stamp}}\", \"fleetType\": \"NORMAL_FLEET\", \"contactMobileCountryCode\": \"{{country_code}}\", \"contactMobileNumber\": \"{{fleet_contact_mobile}}\", \"contactEmail\": \"fleet-{{run_stamp}}@example.com\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('fleet created', () => pm.response.to.have.status(200));",
              "const id = pm.response.json().fleetId;",
              "pm.test('a fleet id comes back', () => pm.expect(id).to.be.a('string').and.not.empty);",
              "pm.environment.set('new_fleet_id', id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - The fleet is a record with no phone of its own",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mockServerUrl}}/mock/sql/select",
        "body": {
          "mode": "raw",
          "raw": "{\"db_name\": \"atlas_dev\", \"db_schema\": \"atlas_driver_offer_bpp\", \"table_name\": \"person\", \"select\": [\"id\", \"role\", \"mobile_number_encrypted\", \"email\"], \"where_clause\": [{\"column_name\": \"id\", \"val\": \"{{new_fleet_id}}\", \"op\": \"=\"}], \"limit\": 50}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The app writes through Redis and a drainer copies to Postgres, so a row can take a while to appear: ask again.",
              "const retryKey = '_retry_' + pm.info.requestId;",
              "const attempts = Number(pm.environment.get(retryKey) || 0);",
              "if (((pm.response.json().rows) || []).length === 0 && attempts < 6) {",
              "  pm.environment.set(retryKey, attempts + 1);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "const rows = (pm.response.json().rows) || [];",
              "pm.test('the placeholder person exists', () => pm.expect(rows.length).to.equal(1));",
              "pm.test('it has no phone', () => pm.expect(rows[0].mobile_number_encrypted).to.equal(null));",
              "pm.test('it has no e-mail', () => pm.expect(rows[0].email).to.equal(null));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 15000); // the app writes through a key-value store and the drainer copies to Postgres; the DB read below must wait for it"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - The fleet has its own contact",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mockServerUrl}}/mock/sql/select",
        "body": {
          "mode": "raw",
          "raw": "{\"db_name\": \"atlas_dev\", \"db_schema\": \"atlas_driver_offer_bpp\", \"table_name\": \"fleet_owner_information\", \"select\": [\"fleet_owner_person_id\", \"fleet_name\", \"contact_mobile_country_code\", \"contact_mobile_number_encrypted\", \"contact_email_encrypted\"], \"where_clause\": [{\"column_name\": \"fleet_owner_person_id\", \"val\": \"{{new_fleet_id}}\", \"op\": \"=\"}], \"limit\": 50}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The app writes through Redis and a drainer copies to Postgres, so a row can take a while to appear: ask again.",
              "const retryKey = '_retry_' + pm.info.requestId;",
              "const attempts = Number(pm.environment.get(retryKey) || 0);",
              "if (((pm.response.json().rows) || []).length === 0 && attempts < 6) {",
              "  pm.environment.set(retryKey, attempts + 1);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "const rows = (pm.response.json().rows) || [];",
              "pm.test('the fleet record exists', () => pm.expect(rows.length).to.equal(1));",
              "pm.test('it is named', () => pm.expect(rows[0].fleet_name).to.include('Scope test fleet'));",
              "pm.test('the contact phone is stored', () => pm.expect(rows[0].contact_mobile_number_encrypted).to.be.a('string').and.not.empty);",
              "pm.test('the contact e-mail is stored', () => pm.expect(rows[0].contact_email_encrypted).to.be.a('string').and.not.empty);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 15000); // the app writes through a key-value store and the drainer copies to Postgres; the DB read below must wait for it"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - The creator is the fleet's one active admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mockServerUrl}}/mock/sql/select",
        "body": {
          "mode": "raw",
          "raw": "{\"db_name\": \"atlas_dev\", \"db_schema\": \"atlas_dashboard\", \"table_name\": \"person_role_assignment\", \"select\": [\"id\", \"person_id\", \"scope_type\", \"scope_id\", \"status\"], \"where_clause\": [{\"column_name\": \"scope_id\", \"val\": \"{{new_fleet_id}}\", \"op\": \"=\"}], \"limit\": 50}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The app writes through Redis and a drainer copies to Postgres, so a row can take a while to appear: ask again.",
              "const retryKey = '_retry_' + pm.info.requestId;",
              "const attempts = Number(pm.environment.get(retryKey) || 0);",
              "if (((pm.response.json().rows) || []).length === 0 && attempts < 6) {",
              "  pm.environment.set(retryKey, attempts + 1);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "const rows = (pm.response.json().rows) || [];",
              "pm.test('exactly one assignment', () => pm.expect(rows.length).to.equal(1));",
              "pm.test('it is A, on that fleet, active', () => {",
              "  pm.expect(rows[0].person_id).to.equal(pm.environment.get('fleet_a_id'));",
              "  pm.expect(rows[0].scope_type).to.equal('FLEET');",
              "  pm.expect(rows[0].status).to.equal('ACTIVE');",
              "});",
              "pm.environment.set('new_assignment_id', rows[0].id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 15000); // the app writes through a key-value store and the drainer copies to Postgres; the DB read below must wait for it"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - A sees the fleet's assignments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "token",
            "value": "{{fleet_a_token}}"
          }
        ],
        "url": "{{baseURL_dashboard_root}}/user/fleetAssignment/{{new_fleet_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('listed', () => pm.response.to.have.status(200));",
              "pm.test('one assignment, ACTIVE', () => {",
              "  const l = pm.response.json();",
              "  pm.expect(l.length).to.equal(1);",
              "  pm.expect(l[0].status).to.equal('ACTIVE');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - A sees the fleet among their own",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "token",
            "value": "{{fleet_a_token}}"
          }
        ],
        "url": "{{baseURL_dashboard_root}}/user/fleetAssignment/mine"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('listed', () => pm.response.to.have.status(200));",
              "pm.test('the new fleet is there', () => pm.expect(pm.response.json().some(a => a.fleetId === pm.environment.get('new_fleet_id'))).to.equal(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - A cannot revoke the fleet's last active admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "token",
            "value": "{{fleet_a_token}}"
          }
        ],
        "url": "{{baseURL_dashboard_root}}/user/fleetAssignment/revoke/{{new_assignment_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refused', () => pm.expect(pm.response.code).to.be.within(400, 499));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - The assignment is still active after the refused revoke",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mockServerUrl}}/mock/sql/select",
        "body": {
          "mode": "raw",
          "raw": "{\"db_name\": \"atlas_dev\", \"db_schema\": \"atlas_dashboard\", \"table_name\": \"person_role_assignment\", \"select\": [\"status\"], \"where_clause\": [{\"column_name\": \"id\", \"val\": \"{{new_assignment_id}}\", \"op\": \"=\"}], \"limit\": 50}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The app writes through Redis and a drainer copies to Postgres, so a row can take a while to appear: ask again.",
              "const retryKey = '_retry_' + pm.info.requestId;",
              "const attempts = Number(pm.environment.get(retryKey) || 0);",
              "if (((pm.response.json().rows) || []).length === 0 && attempts < 6) {",
              "  pm.environment.set(retryKey, attempts + 1);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "const rows = (pm.response.json().rows) || [];",
              "pm.test('still ACTIVE', () => pm.expect(rows[0].status).to.equal('ACTIVE'));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 15000); // the app writes through a key-value store and the drainer copies to Postgres; the DB read below must wait for it"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - A cannot accept an offer that is not pending",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "token",
            "value": "{{fleet_a_token}}"
          }
        ],
        "url": "{{baseURL_dashboard_root}}/user/fleetAssignment/accept/{{new_assignment_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refused', () => pm.expect(pm.response.code).to.be.within(400, 499));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - A fleet needs a name",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "token",
            "value": "{{fleet_a_token}}"
          }
        ],
        "url": "{{baseURL_direct}}/{{dashboard_merchant_id}}/{{dashboard_city}}/fleet/v2/create",
        "body": {
          "mode": "raw",
          "raw": "{\"fleetName\": \"   \"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refused', () => pm.expect(pm.response.code).to.be.within(400, 499));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 - A temp code is refused for a fleet owner (it is made only for drivers)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "token",
            "value": "{{dashboard_token}}"
          }
        ],
        "url": "{{baseURL_direct}}/{{dashboard_merchant_id}}/{{dashboard_city}}/driver/{{fleet_a_id}}/generateTempAppCode"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refused for a non-driver', () => pm.expect(pm.response.code).to.be.within(400, 499));"
            ]
          }
        }
      ]
    }
  ]
}