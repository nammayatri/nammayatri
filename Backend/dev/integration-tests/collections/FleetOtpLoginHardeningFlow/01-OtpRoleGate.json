{
  "info": {
    "name": "FleetOtpLoginHardening - OTP never opens a session for an admin-role person",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// One-time per run: random mobile so the run is repeatable and can run alongside others.",
          "if (!pm.collectionVariables.get('_fo_init')) {",
          "  const r = Math.floor(Math.random() * 900000000) + 100000000;",
          "  pm.environment.set('fleet_owner_mobile', '9' + String(r).slice(0, 8));",
          "  pm.collectionVariables.set('_fo_init', '1');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Switch Dashboard to NAMMA/Bangalore",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "token",
            "value": "{{dashboard_token}}"
          }
        ],
        "url": "{{dashboard_base_url}}/user/switchMerchantAndCity",
        "body": {
          "mode": "raw",
          "raw": "{\"merchantId\": \"{{dashboard_merchant_id}}\", \"city\": \"{{city}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('switch dashboard 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Fleet Owner Login OTP (new phone)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseURL_BPP_Dashboard_Internal}}/{{dashboard_merchant_id}}/{{dashboard_city}}/fleet/v2/login/otp",
        "body": {
          "mode": "raw",
          "raw": "{\"mobileNumber\": \"{{fleet_owner_mobile}}\", \"mobileCountryCode\": \"{{country_code}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login otp 200', () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('fleet_owner_mobile', '9' + String(Math.floor(Math.random() * 1e9)).padStart(9, '0'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Fleet Owner Verify OTP (fleet role is allowed)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseURL_BPP_Dashboard_Internal}}/{{dashboard_merchant_id}}/{{dashboard_city}}/fleet/v2/verify/otp",
        "body": {
          "mode": "raw",
          "raw": "{\"mobileNumber\": \"{{fleet_owner_mobile}}\", \"mobileCountryCode\": \"{{country_code}}\", \"otp\": \"{{login_otp}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('verify otp 200', () => pm.response.to.have.status(200));",
              "pm.test('session token issued', () => pm.expect(pm.response.json().authToken).to.be.a('string').and.not.empty);",
              "pm.environment.set('fleet_owner_token', pm.response.json().authToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Resolve fleet_owner_id (the person the session belongs to)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mockServerUrl}}/mock/sql/select",
        "body": {
          "mode": "raw",
          "raw": "{\"db_name\": \"atlas_dev\", \"db_schema\": \"atlas_dashboard\", \"table_name\": \"registration_token\", \"select\": [\"token\", \"person_id\"], \"where_clause\": [{\"column_name\": \"token\", \"val\": \"{{fleet_owner_token}}\", \"op\": \"=\"}], \"limit\": 5}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The app writes through Redis and a drainer copies to Postgres, so a row can take a while to appear: ask again.",
              "const retryKey = '_retry_' + pm.info.requestId;",
              "const attempts = Number(pm.environment.get(retryKey) || 0);",
              "if (((pm.response.json().rows) || []).length === 0 && attempts < 6) {",
              "  pm.environment.set(retryKey, attempts + 1);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "const rows = (pm.response.json().rows) || [];",
              "pm.test('found the session', () => pm.expect(rows.length).to.equal(1));",
              "pm.environment.set('fleet_owner_id', rows[0].person_id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 15000); // the app writes through a key-value store and the drainer copies to Postgres; the DB read below must wait for it"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Read the fleet owner's dashboard role",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mockServerUrl}}/mock/sql/select",
        "body": {
          "mode": "raw",
          "raw": "{\"db_name\": \"atlas_dev\", \"db_schema\": \"atlas_dashboard\", \"table_name\": \"person\", \"select\": [\"id\", \"role_id\"], \"where_clause\": [{\"column_name\": \"id\", \"val\": \"{{fleet_owner_id}}\", \"op\": \"=\"}], \"limit\": 50}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const rows = (pm.response.json().rows) || [];",
              "pm.test('fleet owner exists in the dashboard', () => pm.expect(rows.length).to.equal(1));",
              "pm.environment.set('fleet_orig_role_id', rows[0].role_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Find a DASHBOARD_ADMIN role",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mockServerUrl}}/mock/sql/select",
        "body": {
          "mode": "raw",
          "raw": "{\"db_name\": \"atlas_dev\", \"db_schema\": \"atlas_dashboard\", \"table_name\": \"role\", \"select\": [\"id\", \"dashboard_access_type\"], \"where_clause\": [{\"column_name\": \"dashboard_access_type\", \"val\": \"DASHBOARD_ADMIN\", \"op\": \"=\"}], \"limit\": 50}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const rows = (pm.response.json().rows) || [];",
              "pm.test('an admin role exists', () => pm.expect(rows.length).to.be.above(0));",
              "pm.environment.set('admin_role_id', rows[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Give the same person an admin role",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mockServerUrl}}/mock/sql/update",
        "body": {
          "mode": "raw",
          "raw": "{\"db_name\": \"atlas_dev\", \"db_schema\": \"atlas_dashboard\", \"table_name\": \"person\", \"set\": {\"role_id\": \"{{admin_role_id}}\"}, \"touch_updated_at\": true, \"where_clause\": [{\"column_name\": \"id\", \"val\": \"{{fleet_owner_id}}\", \"op\": \"=\"}]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('role updated', () => pm.expect(pm.response.json().rowcount).to.equal(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "07b - Drop cached copies of the person",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"pattern\":\"*{{fleet_owner_id}}*\",\"target\":\"cluster\"}"
        },
        "url": "{{mockServerUrl}}/mock/redis/del"
      }
    },
    {
      "name": "08 - Login OTP again for the same phone",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseURL_BPP_Dashboard_Internal}}/{{dashboard_merchant_id}}/{{dashboard_city}}/fleet/v2/login/otp",
        "body": {
          "mode": "raw",
          "raw": "{\"mobileNumber\": \"{{fleet_owner_mobile}}\", \"mobileCountryCode\": \"{{country_code}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login otp 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Verify OTP is refused for an admin-role person",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseURL_BPP_Dashboard_Internal}}/{{dashboard_merchant_id}}/{{dashboard_city}}/fleet/v2/verify/otp",
        "body": {
          "mode": "raw",
          "raw": "{\"mobileNumber\": \"{{fleet_owner_mobile}}\", \"mobileCountryCode\": \"{{country_code}}\", \"otp\": \"{{login_otp}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refused, not 200', () => pm.expect(pm.response.code).to.be.within(400, 499));",
              "pm.test('no session token in the response', () => {",
              "  let body = {}; try { body = pm.response.json(); } catch (e) {}",
              "  pm.expect(body.authToken).to.equal(undefined);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Restore the original dashboard role",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mockServerUrl}}/mock/sql/update",
        "body": {
          "mode": "raw",
          "raw": "{\"db_name\": \"atlas_dev\", \"db_schema\": \"atlas_dashboard\", \"table_name\": \"person\", \"set\": {\"role_id\": \"{{fleet_orig_role_id}}\"}, \"touch_updated_at\": true, \"where_clause\": [{\"column_name\": \"id\", \"val\": \"{{fleet_owner_id}}\", \"op\": \"=\"}]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('role restored', () => pm.expect(pm.response.json().rowcount).to.equal(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Drop cached copies of the person",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"pattern\":\"*{{fleet_owner_id}}*\",\"target\":\"cluster\"}"
        },
        "url": "{{mockServerUrl}}/mock/redis/del"
      }
    }
  ]
}