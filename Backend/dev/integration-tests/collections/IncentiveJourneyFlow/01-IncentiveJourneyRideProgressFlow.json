    {
      "name": "Poll GET /incentive/journey/list (milestone progress)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "token",
            "value": "{{driver_token}}"
          }
        ],
        "url": {
          "raw": "{{baseURL_namma_P}}/incentive/journey/list"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var waitMs = parseInt(pm.environment.get('ij_eval_wait_ms') || '12000', 10);",
              "var start = Date.now();",
              "while (Date.now() - start < waitMs) { /* busy wait for DriverCoinsAndJourney kafka consumer */ }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var MAX_ATTEMPTS = 12;",
              "var POLL_MS = 2500;",
              "var attempt = 0;",
              "var token = pm.environment.get('driver_token');",
              "var base = pm.environment.get('baseURL_namma_P');",
              "var journeyId = pm.environment.get('ij_journey_id');",
              "var url = base + '/incentive/journey/list';",
              "function poll() {",
              "  pm.sendRequest({",
              "    url: url,",
              "    method: 'GET',",
              "    header: { token: token }",
              "  }, function (err, res) {",
              "    attempt++;",
              "    if (!err && res.code === 200) {",
              "      var d = res.json();",
              "      var journeys = d.journeys || [];",
              "      var hit = journeys.find(function (j) { return j.journeyId === journeyId; });",
              "      if (hit) {",
              "        var ms = (hit.milestones || []).find(function (m) {",
              "          return (m.currentValue || 0) >= 1 || ['Completed', 'Rewarded', 'InProgress'].indexOf(m.status) >= 0;",
              "        });",
              "        if (ms) {",
              "          pm.test('Journey appears in list', function () { pm.expect(hit).to.not.be.undefined; });",
              "          pm.test('Milestone progressed after ride', function () {",
              "            pm.expect(ms.currentValue >= 1 || ['Completed', 'Rewarded', 'InProgress'].indexOf(ms.status) >= 0).to.be.true;",
              "          });",
              "          console.log('IJ poll hit status=', ms.status, 'currentValue=', ms.currentValue, 'attempt=', attempt);",
              "          return;",
              "        }",
              "      }",
              "    }",
              "    if (attempt >= MAX_ATTEMPTS) {",
              "      pm.test('Milestone progress appeared (is kafka-consumers / DriverCoinsAndJourney running?)', function () {",
              "        throw new Error('No milestone progress after ' + MAX_ATTEMPTS + ' polls \u2014 is kafka-ride-events-consumer-exe (RIDE_EVENTS_CONSUMER) running in the mobility stack?');",
              "      });",
              "      return;",
              "    }",
              "    setTimeout(poll, POLL_MS);",
              "  });",
              "}",
              "poll();"
            ]
          }
        }
      ]
    },
