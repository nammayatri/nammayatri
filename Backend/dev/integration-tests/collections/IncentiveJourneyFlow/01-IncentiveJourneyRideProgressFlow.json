{
  "info": {
    "name": "Incentive Journey Ride Progress Flow",
    "description": "Provider E2E: dashboard creates Daily incentive journey + milestone (RideCompleted GTE 1 \u2192 Coins 10), assigns driver, completes Bangalore AUTO cash ride, polls driver UI list/history until milestone progress, optional dashboard stats, cleanup.\n\nRequires kafka-consumers (DriverCoinsAndJourney / RIDE_EVENTS). Dashboard peer path after cutover: .../incentiveJourney/...\n\nSee IncentiveJourneyFlow/Rules.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-skip mock-server requests when envType is not Local.",
          "(function () {",
          "  var envType = pm.environment.get('envType') || 'Local';",
          "  if (envType === 'Local') return;",
          "  var raw = (pm.request && pm.request.url && pm.request.url.toString()) || '';",
          "  if (raw.indexOf('mockServerUrl') !== -1 || raw.indexOf('mock_fcm_url') !== -1) {",
          "    console.log('[skip] mock-only request on envType=' + envType + ': ' + (pm.info && pm.info.requestName));",
          "    if (pm.execution && typeof pm.execution.skipRequest === 'function') {",
          "      pm.execution.skipRequest();",
          "    }",
          "  }",
          "})();",
          "",
          "if (!pm.collectionVariables.get('_test_driver_number')) {",
          "  var dNum = '9' + Math.floor(100000000 + Math.random() * 899999999);",
          "  var rNum = '8' + Math.floor(100000000 + Math.random() * 899999999);",
          "  var regNo = 'KA' + String(Math.floor(10 + Math.random() * 89)) + String.fromCharCode(65 + Math.floor(Math.random() * 26)) + String.fromCharCode(65 + Math.floor(Math.random() * 26)) + String(Math.floor(1000 + Math.random() * 8999));",
          "  var suffix = String(Math.floor(100000 + Math.random() * 899999));",
          "  pm.collectionVariables.set('_test_driver_number', dNum);",
          "  pm.collectionVariables.set('_test_rider_number', rNum);",
          "  pm.collectionVariables.set('_test_reg_no', regNo);",
          "  pm.collectionVariables.set('_test_ij_suffix', suffix);",
          "  pm.collectionVariables.set('_test_cohort_name', 'INT_TEST_IJ_COHORT_' + suffix);",
          "  pm.collectionVariables.set('_test_journey_name', 'INT_TEST_IJ_JOURNEY_' + suffix);",
          "  var now = new Date();",
          "  pm.collectionVariables.set('_test_start_date', now.toISOString());",
          "  var validTill = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);",
          "  pm.collectionVariables.set('_test_valid_till', validTill.toISOString());",
          "  var fromDate = now.toISOString().slice(0, 10);",
          "  var toDate = new Date(now.getTime() + 24 * 60 * 60 * 1000).toISOString().slice(0, 10);",
          "  pm.collectionVariables.set('_test_from_date', fromDate);",
          "  pm.collectionVariables.set('_test_to_date', toDate);",
          "  console.log('IJ test driver:', dNum, 'rider:', rNum, 'reg:', regNo, 'suffix:', suffix);",
          "}"
        ]
      }
    }
  ],
