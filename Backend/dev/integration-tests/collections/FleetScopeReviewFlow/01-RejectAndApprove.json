            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mockServerUrl}}/mock/sql/insert",
        "body": {
          "mode": "raw",
          "raw": "{\"db_name\": \"atlas_dev\", \"db_schema\": \"atlas_dashboard\", \"table_name\": \"person_role_assignment\", \"values\": {\"id\": \"{{run_stamp}}-review-assignment\", \"person_id\": \"{{admin_id}}\", \"role_id\": \"{{fleet_role_id}}\", \"scope_type\": \"FLEET\", \"scope_id\": \"{{fleet_a_id}}\", \"merchant_id\": \"{{dashboard_merchant_row_id}}\", \"status\": \"ACTIVE\"}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('inserted', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('run_stamp', String(Date.now()));"
            ]
          }
        }
      ]
