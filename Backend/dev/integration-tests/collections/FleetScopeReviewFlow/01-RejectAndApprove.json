          "raw": "{\"status\": \"Rejected\", \"reason\": \"not allowed\", \"fleetOwnerId\": \"{{fleet_a_id}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refused', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
            ]
          }
        }
      ]
    },
