{
  "info": {
    "name": "FleetScopeReview - rejecting and approving a fleet",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 A - login OTP (direct tree)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseURL_direct}}/{{dashboard_merchant_id}}/{{dashboard_city}}/fleet/v2/login/otp",
        "body": {
          "mode": "raw",
          "raw": "{\"mobileNumber\": \"{{fleet_a_mobile}}\", \"mobileCountryCode\": \"{{country_code}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login otp 200', () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const rnd = () => '9' + String(Math.floor(Math.random() * 900000000) + 100000000).slice(0, 8);",
              "pm.environment.set('fleet_a_mobile', rnd());"
            ]
          }
        }
      ]
    },
    {
      "name": "02 A - verify OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseURL_direct}}/{{dashboard_merchant_id}}/{{dashboard_city}}/fleet/v2/verify/otp",
        "body": {
          "mode": "raw",
          "raw": "{\"mobileNumber\": \"{{fleet_a_mobile}}\", \"mobileCountryCode\": \"{{country_code}}\", \"otp\": \"{{login_otp}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('verify otp 200', () => pm.response.to.have.status(200));",
              "const t = pm.response.json().authToken;",
              "pm.test('session token issued', () => pm.expect(t).to.be.a('string').and.not.empty);",
              "pm.environment.set('fleet_a_token', t);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - A's fleet id (the person the session belongs to)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mockServerUrl}}/mock/sql/select",
        "body": {
          "mode": "raw",
          "raw": "{\"db_name\": \"atlas_dev\", \"db_schema\": \"atlas_dashboard\", \"table_name\": \"registration_token\", \"select\": [\"token\", \"person_id\"], \"where_clause\": [{\"column_name\": \"token\", \"val\": \"{{fleet_a_token}}\", \"op\": \"=\"}], \"limit\": 5}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The app writes through Redis and a drainer copies to Postgres, so a row can take a while to appear: ask again.",
              "const retryKey = '_retry_' + pm.info.requestId;",
              "const attempts = Number(pm.environment.get(retryKey) || 0);",
              "if (((pm.response.json().rows) || []).length === 0 && attempts < 6) {",
              "  pm.environment.set(retryKey, attempts + 1);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "const rows = (pm.response.json().rows) || [];",
              "pm.test('found the session', () => pm.expect(rows.length).to.equal(1));",
              "pm.environment.set('fleet_a_id', rows[0].person_id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 15000); // the app writes through a key-value store and the drainer copies to Postgres; the DB read below must wait for it"
            ]
          }
        }
      ]
    },
