    {
      "name": "14 - A is marked unverified, with the reason and who rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mockServerUrl}}/mock/sql/select",
        "body": {
          "mode": "raw",
          "raw": "{\"db_name\": \"atlas_dev\", \"db_schema\": \"atlas_dashboard\", \"table_name\": \"person\", \"select\": [\"id\", \"verified\", \"rejection_reason\", \"rejected_by\", \"rejected_at\"], \"where_clause\": [{\"column_name\": \"id\", \"val\": \"{{fleet_a_id}}\", \"op\": \"=\"}], \"limit\": 50}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The app writes through Redis and a drainer copies to Postgres, so a row can take a while to appear: ask again.",
              "const retryKey = '_retry_' + pm.info.requestId;",
              "const attempts = Number(pm.environment.get(retryKey) || 0);",
              "if (((pm.response.json().rows) || []).length === 0 && attempts < 6) {",
              "  pm.environment.set(retryKey, attempts + 1);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "const rows = (pm.response.json().rows) || [];",
              "pm.test('the account is kept', () => pm.expect(rows.length).to.equal(1));",
              "pm.test('unverified', () => pm.expect(rows[0].verified).to.equal(false));",
              "pm.test('reason kept', () => pm.expect(rows[0].rejection_reason).to.equal('review flow'));",
              "pm.test('rejecter kept', () => pm.expect(rows[0].rejected_by).to.equal(pm.environment.get('admin_id')));",
              "pm.test('time kept', () => pm.expect(rows[0].rejected_at).to.not.equal(null));"
            ]
          }
        }
