    {
      "name": "Get Nearby Ride Requests (Driver)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Wait 25s for Kafka allocator batch cycle (~22s) to distribute search to nearby drivers",
              "const start = Date.now();",
              "while (Date.now() - start < 25000) { /* busy wait */ }"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var d = pm.response.json();",
              "if (d.searchRequestsForDriver && d.searchRequestsForDriver.length > 0) {",
              "    // Pick the newest search (latest startTime): a request from an earlier, cancelled test can still be listed first.",
              "    var req = d.searchRequestsForDriver.reduce(function (a, b) { return new Date(b.startTime) > new Date(a.startTime) ? b : a; });",
              "    pm.environment.set('searchTryId', req.searchTryId);",
              "    var step = [req.driverStepFeeWithCurrency, req.driverDefaultStepFeeWithCurrencyV2, req.driverDefaultStepFeeWithCurrency].map(function (p) { return p ? Number(p.amount) : 0; }).filter(function (x) { return x > 0; })[0] || 0;",
              "    pm.environment.set('_drv_offer_net', step);",
              "    pm.environment.set('_drv_offer_json', step ? JSON.stringify({amount: step, currency: req.baseFareWithCurrency.currency}) : 'null');",
              "    pm.test('Driver can add an amount (driver extra fee step)', function () { pm.expect(step).to.be.above(0); });",
              "    pm.test('Popup shows the customer tip', function () { pm.expect(req.customerExtraFeeWithCurrency ? Number(req.customerExtraFeeWithCurrency.amount) : 0).to.be.above(0); });",
              "    console.log('Driver offer (net step):', step, '| popup customer tip:', JSON.stringify(req.customerExtraFeeWithCurrency));",
              "    console.log('Got search request, searchTryId:', req.searchTryId, 'baseFare:', req.baseFare, 'variant:', req.requestedVehicleVariant);",
              "} else {",
              "    console.log('WARNING: No nearby ride requests found for driver. Response:', JSON.stringify(d));",
              "}",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Has search requests', function () {",
              "    pm.expect(d.searchRequestsForDriver).to.be.an('array').that.is.not.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
