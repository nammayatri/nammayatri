    {
      "name": "Get Booking (Rider)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Wait for booking to be created after driver acceptance",
              "const delay = pm.environment.get('booking_wait_ms') || 5000;",
              "const start = Date.now();",
              "while (Date.now() - start < delay) { /* busy wait */ }"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var d = pm.response.json();",
              "if (d.list && d.list.length > 0) {",
              "    var booking = d.list[0];",
              "    pm.environment.set('customer_bookingId', booking.id);",
              "    var otp = booking.rideOtp;",
              "    if (!otp && booking.rideList && booking.rideList.length > 0) {",
              "        otp = booking.rideList[0].rideOtp;",
              "    }",
              "    pm.environment.set('ride_otp', otp);",
              "    console.log('Booking:', booking.id, 'OTP:', otp, 'Status:', booking.status);",
              "}",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "if (d.list && d.list.length > 0) {",
              "    var b = d.list[0];",
              "    var line = function (b, t) { var x = (b.estimatedFareBreakup || []).filter(function (l) { return l.description === t; })[0]; return x ? Number(x.amountWithCurrency ? x.amountWithCurrency.amount : x.amount) : 0; };",
              "    var custLine = line(b, 'CUSTOMER_SELECTED_FARE'), drvLine = line(b, 'DRIVER_SELECTED_FARE');",
              "    var total = Number(b.estimatedTotalFareWithCurrency.amount);",
              "    console.log('Booking: total', total, '| estimate', pm.environment.get('_est_total_gross'), '| CUSTOMER_SELECTED_FARE', custLine, '| DRIVER_SELECTED_FARE', drvLine);",
              "    pm.test('Booking shows the customer tip as chosen', function () { pm.expect(custLine).to.be.closeTo(Number(pm.environment.get('_cust_extra_gross')), 1); });",
              "    pm.test('Booking shows the driver addition', function () { pm.expect(drvLine).to.be.above(0); });",
              "    pm.test('Booking total = estimate + customer tip + driver addition (UI rounding)', function () { pm.expect(total).to.be.closeTo(Number(pm.environment.get('_est_total_gross')) + custLine + drvLine, 1.5); });",
              "    pm.test('Booking total is shown rounded to the currency', function () { pm.expect(Number.isInteger(total) || b.estimatedTotalFareWithCurrency.currency !== 'INR').to.equal(true); });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
