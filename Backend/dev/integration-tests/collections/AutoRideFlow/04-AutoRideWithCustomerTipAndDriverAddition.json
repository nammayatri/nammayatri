    {
      "name": "Allow Driver Extra Fee (BPP)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Fare products listed', function () { pm.response.to.have.status(200); });",
              "var ids = ((pm.response.json() || {}).fareProducts || []).filter(function (p) { return p.tripCategory && p.tripCategory.tag === 'OneWay' && p.tripCategory.contents === 'OneWayOnDemandDynamicOffer'; }).map(function (p) { return p.farePolicyId; });",
              "ids = ids.filter(function (id, k) { return ids.indexOf(id) === k; });",
              "pm.test('Auto one-way dynamic fare policies found', function () { pm.expect(ids.length).to.be.above(0); });",
              "var base = pm.variables.replaceIn('{{baseURL_BPP_Dashboard_Internal}}/{{dashboard_merchant_id}}/{{dashboard_city}}');",
              "var token = pm.environment.get('dashboard_token');",
              "var post = function (id, action, startDistance, bound) {",
              "    pm.sendRequest({url: base + '/merchant/config/farePolicy/' + id + '/driverExtraFeeBounds/' + action + '?startDistance=' + startDistance, method: 'POST', header: {'Content-Type': 'application/json', token: token}, body: {mode: 'raw', raw: JSON.stringify(bound)}}, function (err, res) {",
              "        pm.test('Driver extra fee bounds ' + action + ' on ' + id + ' @' + startDistance, function () { pm.expect(err).to.eql(null); pm.expect(res.code).to.eql(200); });",
              "    });",
              "};",
              "ids.forEach(function (id) {",
              "    pm.sendRequest({url: base + '/farePolicyV2/policy/' + id, method: 'GET', header: {token: token}}, function (err, res) {",
              "        var bounds = (!err && res.code === 200) ? (((res.json() || {}).policy || {}).driverExtraFeeBounds || []) : [];",
              "        if (bounds.length === 0) { post(id, 'create', 0, {minFee: 0, maxFee: 30, stepFee: 10, defaultStepFee: 10}); return; }",
              "        bounds.forEach(function (b) { post(id, 'update', b.startDistance, {minFee: b.minFee || 0, maxFee: Math.max(Number(b.maxFee) || 0, 30), stepFee: 10, defaultStepFee: 10}); });",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "token",
            "value": "{{dashboard_token}}"
          }
        ],
        "url": "{{baseURL_BPP_Dashboard_Internal}}/{{dashboard_merchant_id}}/{{dashboard_city}}/farePolicyV2/list?serviceTier=%22{{auto_vehicle_variant}}%22"
      }
    },
    {
      "name": "Ride Search",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "setTimeout(function(){}, 2000);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var d = pm.response.json();",
              "pm.environment.set('searchId', d.searchId);",
              "console.log('Search ID:', d.searchId);",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "// Wait for async beckn search processing across services\nconst _delay = 5000; const _start = Date.now(); while (Date.now() - _start < _delay) {}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "token",
            "value": "{{rider_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"fareProductType\": \"ONE_WAY\", \"contents\": {\"origin\": {\"address\": {\"area\": \"Test Origin\", \"areaCode\": \"000000\", \"city\": \"{{city}}\", \"country\": \"India\", \"state\": \"{{state}}\"}, \"gps\": {\"lat\": {{origin_lat}}, \"lon\": {{origin_lon}}}}, \"destination\": {\"address\": {\"area\": \"Test Destination\", \"areaCode\": \"000000\", \"city\": \"{{city}}\", \"country\": \"India\", \"state\": \"{{state}}\"}, \"gps\": {\"lat\": {{dest_lat}}, \"lon\": {{dest_lon}}}}}}"
        },
        "url": {
          "raw": "{{baseUrl_app}}/rideSearch",
          "host": [
            "{{baseUrl_app}}"
          ],
          "path": [
            "rideSearch"
          ]
        }
      }
    },
    {
      "name": "Get Search Results",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "setTimeout(function(){}, 5000);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var d = pm.response.json();",
              "if (d.estimates && d.estimates.length > 0) {",
              "    var want = pm.environment.get('auto_vehicle_variant') || 'AUTO_RICKSHAW';",
              "    var est = d.estimates.find(e => e.vehicleVariant === want)",
              "           || d.estimates.find(e => e.vehicleServiceTierType === want)",
              "           || d.estimates[0];",
              "    pm.environment.set('estimateId', est.id);",
              "    var tips = (est.tipOptions || []).filter(function (x) { return Number(x) > 0; });",
              "    pm.environment.set('_cust_extra_gross', tips.length > 0 ? Number(tips[0]) : 0);",
              "    pm.environment.set('_est_total_gross', Number(est.estimatedTotalFareWithCurrency.amount));",
              "    pm.environment.set('currency', est.estimatedTotalFareWithCurrency.currency);",
              "    pm.test('Estimate offers a customer tip option', function () { pm.expect(tips.length, 'tipOptions > 0').to.be.above(0); });",
              "    console.log('Customer tip (gross):', pm.environment.get('_cust_extra_gross'), '| estimate total:', pm.environment.get('_est_total_gross'), '| tipOptions:', JSON.stringify(est.tipOptions));",
              "    console.log('Estimate:', est.id, est.vehicleVariant, est.estimatedFare, '(wanted', want + ')');",
              "}",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Has estimates', function () { pm.expect(d, 'response body').to.be.an('object'); pm.expect(d.estimates, 'estimates field').to.be.an('array'); pm.expect(d.estimates.length, 'estimate count').to.be.above(0); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "token",
            "value": "{{rider_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl_app}}/rideSearch/{{searchId}}/results",
