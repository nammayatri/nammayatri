    {
      "name": "Get Ride Config (Partial Merge Preserves Others)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "token",
            "value": "{{rider_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl_app}}/riderPreference/rideConfig",
          "host": [
            "{{baseUrl_app}}"
          ],
          "path": [
            "riderPreference",
            "rideConfig"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var d = pm.response.json();",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('merge: isPetRide takes the newly sent value', function () {",
              "    pm.expect(d.isPetRide, 'got: ' + JSON.stringify(d.isPetRide)).to.eql(true);",
              "});",
              "pm.test('merge: isBusiness keeps its previous value (false), not nulled', function () {",
              "    pm.expect(d.isBusiness, 'omitted field was wiped \u2014 merge regressed. got: ' + JSON.stringify(d.isBusiness)).to.eql(false);",
              "});",
              "pm.test('merge: isTransitEnabled keeps its previous value (false), not nulled', function () {",
              "    pm.expect(d.isTransitEnabled, 'omitted field was wiped \u2014 merge regressed. got: ' + JSON.stringify(d.isTransitEnabled)).to.eql(false);",
              "});",
              "pm.test('merge: isAutoAssign keeps its previous value (true), not nulled', function () {",
              "    pm.expect(d.isAutoAssign, 'omitted field was wiped \u2014 merge regressed. got: ' + JSON.stringify(d.isAutoAssign)).to.eql(true);",
              "});",
              "console.log('rideConfig =', JSON.stringify(d));"
            ]
          }
        }
      ]
    },
