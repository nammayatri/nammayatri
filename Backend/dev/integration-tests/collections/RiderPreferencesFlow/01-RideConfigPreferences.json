    {
      "name": "Get Ride Config (Partial false Applies, Others Preserved)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "token",
            "value": "{{rider_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl_app}}/riderPreference/rideConfig",
          "host": [
            "{{baseUrl_app}}"
          ],
          "path": [
            "riderPreference",
            "rideConfig"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var d = pm.response.json();",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('a partial false is applied, not treated as absent', function () {",
              "    pm.expect(d.isAutoAssign, 'true->false via partial payload was dropped; Nothing/false likely conflated. got: ' + JSON.stringify(d.isAutoAssign)).to.eql(false);",
              "});",
              "pm.test('isPetRide still preserved alongside the false write', function () {",
              "    pm.expect(d.isPetRide, 'got: ' + JSON.stringify(d.isPetRide)).to.eql(true);",
              "});",
              "pm.test('isBusiness still preserved', function () {",
              "    pm.expect(d.isBusiness, 'got: ' + JSON.stringify(d.isBusiness)).to.eql(false);",
              "});",
              "console.log('rideConfig =', JSON.stringify(d));"
            ]
          }
        }
      ]
    },
