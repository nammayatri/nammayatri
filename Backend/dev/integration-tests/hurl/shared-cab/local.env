# Local rider-app (dev dhall): SERVICE_PORT 8013. internal_key = rider-app internalAPIKey.
base_url=http://localhost:8013
internal_key=test-bap-api-key

# Shared-cab integrated_bpp_config id for the city (task 0.3).
ibc_id=REPLACE_ME
# route_a / route_a_return must be a direction pair in the feed; route_b any other shared-cab route.
route_a=SC-MAWLAI-F
route_a_return=SC-MAWLAI-R
route_b=SC-JAIAW-F
# Canonical plate (upper case, no spaces): it is also the Redis key the flush step deletes.
plate=ML05A9999
driver=scenario-driver-1
lat=25.5788
lon=91.8933

# Rider login (sandbox OTP is always 7891; local dev accepts it too).
merchantId=REPLACE_ME
merchantOperatingCityId=REPLACE_ME
mobileNumber=9000000031
otp=7891
deviceToken=hurl-shared-cab

# A board -> drop pair on route_a that no other mode serves, so the shared cab is the first itinerary.
from_lat=25.5788
from_lon=91.8933
to_lat=25.5690
to_lon=91.8830
