# Local rider-app (dev dhall): SERVICE_PORT 8013. internal_key = rider-app internalAPIKey.
base_url=http://localhost:8013
internal_key=test-bap-api-key

# The shared-cab agency_key (driver-app and rider-app exchange the agency, not a per-DB row id). Body field is "agencyId".
ibc_id=shillong_shared_cab:SHARED_CAB
# route_a / route_a_return must be a direction pair in the feed; route_b any other shared-cab route.
route_a=SC-PRD-F
route_a_return=SC-PRD-R
route_b=SC-NEIGRIHMS-F
# Canonical plate (upper case, no spaces): it is also the Redis key the flush step deletes.
plate=ML05A9999
driver=scenario-driver-1
# Boarding: the in-cab code is the plate's last 4; cab B is the re-bind target on route_a.
plate_code=9999
plate_b=ML05B8888
plate_b_code=8888
driver_b=scenario-driver-2
# The driver card the selects send (the leg status shows them); the boarding flow asserts the first pair.
driver_name=Asha K
vehicle_model=Dzire
driver_b_name=Ravi M
vehicle_b_model=Celerio
lat=25.5788
lon=91.8933

# Rider login (sandbox OTP is always 7891; local dev accepts it too).
merchantId=REPLACE_ME
merchantOperatingCityId=REPLACE_ME
mobileNumber=9000000031
otp=7891
deviceToken=hurl-shared-cab

# A board -> drop pair on route_a that no other mode serves, so the shared cab is the first itinerary.
from_lat=25.5788
from_lon=91.8933
to_lat=25.5690
to_lon=91.8830

# Masked call (call-chat-flow.hurl): the city's Exotel ExoPhone as the leg status shows it. The dial-in asks driver-app for the number, so
# `driver` must be a real driver id there.
exophone=REPLACE_ME
# Where the rider stands when boarding in call-chat-flow.hurl: within boardProximityM of the cab (the board stop when no cab pings).
board_lat=25.5788
board_lon=91.8933
# The driver-app the real `driver` logs in to, and that driver's token (the driver calls the rider through it).
driver_base_url=http://localhost:8016
driver_token=REPLACE_ME
# Without a leading zero (hurl reads a zero-led value as a number); the asserts allow the zero, the dial-in tries both spellings.

# The operating city name the rider app sends (the local seed hosts the Shillong feed on the imported Chennai city).
city=Chennai

# A stop of the cab feed and a cab route passing it (nearby-bus.hurl).
stop_code=SC_FIREBRIGADE
stop_route=SC-PRD-F
