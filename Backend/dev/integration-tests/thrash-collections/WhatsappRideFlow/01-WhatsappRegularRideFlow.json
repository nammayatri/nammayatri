    {
      "name": "WA: Ride Type (Regular)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "(function () {",
              "  var to = pm.collectionVariables.get('_test_rider_number');",
              "  var seq = parseInt(pm.collectionVariables.get('_wa_msg_seq') || '0', 10) + 1;",
              "  pm.collectionVariables.set('_wa_msg_seq', String(seq));",
              "  var envelope = {",
              "    object: 'whatsapp_business_account',",
              "    entry: [{ id: 'entry-1', changes: [{ field: 'messages', value: {",
              "      messaging_product: 'whatsapp',",
              "      metadata: { display_phone_number: '15550000000', phone_number_id: pm.environment.get('whatsapp_phone_number_id') },",
              "      contacts: [{ profile: { name: to }, wa_id: to }],",
              "      messages: [{",
              "        from: to, id: 'wamid.wa-' + to + '-' + seq, timestamp: String(Math.floor(Date.now() / 1000)),",
              "        type: 'interactive',",
              "        interactive: { type: 'button_reply', button_reply: { id: 'ride_type:regular', title: 'Ride with destination' } }",
              "      }]",
              "    }}] }]",
              "  };",
              "  var raw = JSON.stringify(envelope);",
              "  pm.request.body.raw = raw;",
              "  var sig = CryptoJS.HmacSHA256(raw, pm.environment.get('whatsapp_app_secret')).toString(CryptoJS.enc.Hex);",
              "  pm.request.headers.upsert({ key: 'X-Hub-Signature-256', value: 'sha256=' + sig });",
              "})();"
            ],
            "type": "text/javascript"
          }
        },
        {"listen": "test", "script": {"exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); }); const s=Date.now(); while(Date.now()-s<1500){}"], "type": "text/javascript"}}
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{}"},
        "url": {"raw": "{{webhook_base_url}}/webhook/whatsapp", "host": ["{{webhook_base_url}}"], "path": ["webhook", "whatsapp"]}
      }
    },
