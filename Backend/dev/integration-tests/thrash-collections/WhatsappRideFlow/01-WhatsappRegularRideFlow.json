    {
      "name": "Get Nearby Ride Requests (Driver)",
      "event": [
        {"listen": "prerequest", "script": {"exec": ["const s=Date.now(); while(Date.now()-s<2000){}"], "type": "text/javascript"}},
        {"listen": "test", "script": {"exec": [
          "var d = pm.response.json();",
          "if (d.searchRequestsForDriver && d.searchRequestsForDriver.length > 0) {",
          "    var req = d.searchRequestsForDriver[0];",
          "    pm.environment.set('searchTryId', req.searchTryId);",
          "    console.log('Got Regular search request, searchTryId:', req.searchTryId, 'variant:', req.requestedVehicleVariant, 'tripCategory:', JSON.stringify(req.tripCategory));",
          "    pm.test('Status 200', function () { pm.response.to.have.status(200); });",
          "    pm.test('Has search requests', function () { pm.expect(d.searchRequestsForDriver).to.be.an('array').that.is.not.empty; });",
          "    pm.collectionVariables.set('_nearby_attempt', '0');",
          "} else {",
          "    var attempt = parseInt(pm.collectionVariables.get('_nearby_attempt') || '0');",
          "    if (attempt < 8) {",
          "        console.log('No nearby requests yet (attempt', attempt + 1, ') - retrying after busy-wait...');",
          "        var t0=Date.now(); while(Date.now()-t0<5000){}",
          "        pm.collectionVariables.set('_nearby_attempt', String(attempt + 1));",
          "        pm.execution.setNextRequest(pm.info.requestName);",
          "    } else {",
          "        console.log('WARNING: No nearby ride requests found for driver after retries. Response:', JSON.stringify(d));",
          "        pm.test('Status 200', function () { pm.response.to.have.status(200); });",
          "        pm.test('Has search requests', function () { pm.expect(d.searchRequestsForDriver).to.be.an('array').that.is.not.empty; });",
          "        pm.collectionVariables.set('_nearby_attempt', '0');",
          "    }",
          "}"
        ], "type": "text/javascript"}}
      ],
