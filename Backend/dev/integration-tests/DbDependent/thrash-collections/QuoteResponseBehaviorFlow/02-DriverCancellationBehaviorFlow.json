   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "var d = pm.response.json();",
       "pm.test('visibility 200', () => pm.response.to.have.status(200));",
       "var rc = (d.counters||{})['RIDE_CANCELLATION']||{};",
       "console.log('RIDE_CANCELLATION daily:', JSON.stringify(rc.daily), 'weekly:', JSON.stringify(rc.weekly));",
       "console.log('activeBlocks:', JSON.stringify(d.activeBlocks));",
       "console.log('activeCooldowns:', JSON.stringify(d.activeCooldowns));",
       "pm.test('2 rides assigned counted (ELIGIBLE)', function () { pm.expect(rc.daily && rc.daily.eligibleCount).to.be.at.least(2); });",
       "pm.test('2 cancellations counted (ACTION)', function () { pm.expect(rc.daily && rc.daily.actionCount).to.be.at.least(2); });",
       "pm.test('rate is meaningful (100% for 2/2)', function () { pm.expect(rc.daily && rc.daily.rate).to.be.at.least(50); });",
       "if (d.activeBlocks && d.activeBlocks.length > 0) { console.log('NOTE: live CANCELLATION-RATE-BEHAVIOR rules BLOCKED this driver - full judging pipeline confirmed:', JSON.stringify(d.activeBlocks)); }",
       "else { console.log('NOTE: no block fired - check rolled-out rule thresholds (min weekly rides may exceed 2).'); }"
      ]
     }
    }
